# Whitelist: only the site code, the subject configs and the published guides go to GitHub.
# Drafts, sources, transcripts and scratch files stay in each subject's own folder under ~/clg/<subject>/.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/render.yaml
!/site/
!/subjects/
/subjects/*/*
!/subjects/*/subject.json
!/subjects/*/videos.json
!/subjects/*/*.html
!/subjects/*/sources/
/public/
__pycache__/
